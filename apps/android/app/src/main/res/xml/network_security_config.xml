<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is off everywhere except the loopback addresses a development
  ff-api is reached on: 10.0.2.2 is the host machine as seen from the
  Android emulator, and 127.0.0.1 is the in-app chart tile server that
  serves PMTiles tiles to MapLibre (see TileServer.kt). A real deployment
  is HTTPS and matches neither exemption.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
