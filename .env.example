# Build-time inputs for `ff-etl` — copy to `.env` and fill in.
#
# `.env` is gitignored; this template is tracked. Nothing here is read
# automatically (no dotenv crate), so load it yourself before a build:
#
#   set -a; . ./.env; set +a
#   cargo run --release -p ff-etl --bin ff-etl
#
# Distinct from `deploy/.env`, which holds the *runtime* secrets ff-api
# needs in production (database URL, OAuth, NOTAM). Nothing in this file
# reaches the server; these are only used while building a cycle.
#
# Both variables are optional, and that is the hazard: unset means the
# pipeline quietly builds a cycle without that country's data, with only a
# log line to mark it. A US-only cycle is ~13,300 airports against ~18,800
# with both — easy to publish by accident.

# openAIP API key. The §3.1.2 fallback tier: states whose official AIS
# cannot be re-hosted (Germany, UK, Canada) or publishes nothing
# (Greenland). Worth ~4,600 airports and ~5,500 airspace volumes.
# Get one from https://www.openaip.net (free account).
FF_OPENAIP_API_KEY=

# France/SIA AIXM export (§3.1). Cart-gated manual download from
# https://www.sia.aviation-civile.gouv.fr — "Données aéronautiques XML
# AIRAC", free. Because it is fetched by hand while the FAA side is
# automatic, it routinely trails by a cycle; that is allowed, and the
# bundle records this file's own effective date so the clients can flag
# the difference. Licence Ouverte: attribution is required and shipped in
# `data_source`.
# Use the path as your build host sees it — WSL, if that is where GDAL is.
FF_AIXM_FR_PATH=

# Where a built cycle is written. Point it somewhere other than the repo's
# own `data/` unless you mean to overwrite what you are serving locally.
FF_ETL_DATA_DIR=
