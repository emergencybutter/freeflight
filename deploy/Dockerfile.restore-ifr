# Builds the emergency restore_ifr_catalog recovery tool — pure metadata
# (reads a PMTiles header, no GDAL). Build context is the workspace root.
FROM rust:1-bookworm AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p ff-etl --bin restore_ifr_catalog

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/restore_ifr_catalog /usr/local/bin/restore_ifr_catalog
CMD ["restore_ifr_catalog"]
