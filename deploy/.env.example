# ff-api server-only secrets. Copy to `deploy/.env` on the server (that file
# is git-ignored and loaded by compose.yml's `env_file`). Every var here is
# optional — a fresh deploy with no .env still starts; the features below
# just stay off until their credentials are set.

# --- OAuth sign-in (routes::auth) -----------------------------------------
# Google and Discord "Log in with…" buttons. A provider only appears in the
# client (and /auth/providers) when BOTH its id and secret are set.
#
# Register these redirect URIs in each provider's console — they must match
# {FF_OAUTH_REDIRECT_BASE}/auth/callback/{provider} exactly:
#   Google : https://freeflight.flyvoyager.net/auth/callback/google
#   Discord: https://freeflight.flyvoyager.net/auth/callback/discord
# For local dev use http://localhost:8080 as the base instead.

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Scopes requested: openid email profile.
FF_OAUTH_GOOGLE_CLIENT_ID=
FF_OAUTH_GOOGLE_CLIENT_SECRET=

# Discord Developer Portal → Applications → OAuth2. Scopes: identify email.
FF_OAUTH_DISCORD_CLIENT_ID=
FF_OAUTH_DISCORD_CLIENT_SECRET=

# Public origin the provider redirects back to (this API's own base URL).
# Required whenever any provider above is configured.
FF_OAUTH_REDIRECT_BASE=https://freeflight.flyvoyager.net

# Comma-separated allowlist of web-client origins the OAuth callback may
# hand a session token to (guards against token exfiltration via a forged
# `return`). Required in prod; localhost origins are always allowed, so
# local dev needs nothing here.
FF_WEB_ORIGINS=https://freeflight.flyvoyager.net

# --- Account database (ff-accounts, DESIGN.md §9.5) ------------------------
# PostgreSQL holding users, sessions, and aircraft records. Leave unset to run
# without it: ff-api still starts, sign-in falls back to in-memory sessions
# (lost on restart, as today), and the aircraft manager reports unavailable.
#
# `postgres18` is the colocated container's name on the shared vya2net network
# ff-api is already joined to — no host/port publishing involved.
#
# The password MUST be percent-encoded (@ -> %40, / -> %2F): this is a URI,
# parsed by sqlx and by deploy/backup-db.sh's pg_dump alike. An unencoded
# password fails to connect with a confusing "unknown host" error.
FF_DATABASE_URL=postgres://freeflight:CHANGEME@postgres18:5432/freeflight

# --- Offsite backup (deploy/backup-db.sh) ----------------------------------
# The account DB is the only thing here that cannot be regenerated from
# upstream, and vya2 has no cluster-wide pg_dump — each app backs up its own.
# Unset LOGIN/PASSWORD to use Scaleway Dedibackup IP-based autologin.
DEDIBACKUP_LOGIN=
DEDIBACKUP_PASSWORD=
DEDIBACKUP_HOST=

# --- FAA NMS NOTAM proxy (routes::notams) ---------------------------------
# Leave unset to run without live NOTAMs (that overlay just stays empty).
FF_NOTAM_CLIENT_ID=
FF_NOTAM_CLIENT_SECRET=
